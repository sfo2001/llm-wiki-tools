# Copy this file to .lwt.env and fill in your credentials.
# .lwt.env is gitignored — never commit real tokens.

CONFLUENCE_URL=https://confluence.example.com
CONFLUENCE_TOKEN=your-personal-access-token-here
CONFLUENCE_SPACE=MYSPACE
CONFLUENCE_PARENT=Wiki Home

DOCKER_PORT=8443
LOCAL_PORT=8080

# LLM provider for unattended lwt jobs (lwt maintain, ingest review) — see ADR-0007.
# Not used by interactive ingest/authoring. Leave LLM_API_BASE_URL unset to skip
# these jobs entirely (they degrade to structural-lint-only).
#
# Default: point at the local model you already use for authoring — zero
# marginal cost. Example for a local llama.cpp/Ollama OpenAI-compatible endpoint:
LLM_API_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
LLM_API_FORMAT=openai
LLM_MODEL=qwen3-30b-a3b

# API keys are sent as plaintext headers (Authorization/x-api-key) — use
# https:// for any non-localhost endpoint.
#
# Optional fallback, tried only if the primary request fails. Any
# OpenAI-compatible or Anthropic-compatible endpoint works.
LLM_FALLBACK_API_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_API_FORMAT=openai
LLM_FALLBACK_MODEL=
